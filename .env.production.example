# TDrive Production Environment
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://tdrive:CHANGE_ME@localhost:5432/tdrive

# Redis (for BullMQ queue)
REDIS_URL=redis://localhost:6379

# Security (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHARS

# Telegram (server-level fallback, users can override via UI)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Telegram Bot (per-user, users register via web UI)
TELEGRAM_BOT_TOKEN=

# Telegram Storage Channel
TDRIVE_STORAGE_CHANNEL=TeleDrive Storage

# App URL (for bot dashboard links)
APP_URL=https://your-domain.com

# Upload Limits (bytes)
TDRIVE_MAX_UPLOAD_BYTES=1073741824
TDRIVE_MAX_ARCHIVE_BYTES=2147483648
TDRIVE_MAX_EDITOR_BYTES=5242880

# Server Files (optional)
SERVER_FILES_MODE=local
SERVER_FILES_ROOT=./server-files

# API
API_PORT=3001
CORS_ORIGIN=https://your-domain.com
