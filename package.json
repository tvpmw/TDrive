{
  "name": "tdrive",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "start:api": "cd apps/api && bun src/index.ts",
    "start:web": "cd apps/web && bun run start",
    "build": "npm-run-all --parallel build:web build:shared",
    "build:web": "cd apps/web && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "db:generate": "cd apps/api && npm run db:generate",
    "db:migrate": "cd apps/api && npm run db:migrate",
    "db:push": "cd apps/api && npm run db:push",
    "deploy:linux": "bash deploy/setup-linux.sh",
    "deploy:windows": "powershell -ExecutionPolicy Bypass -File deploy/setup-windows.ps1",
    "check:responsive": "node scripts/check-responsive.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "playwright": "^1.61.1",
    "typescript": "^5.7.0"
  }
}
