# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tdrive

# Redis (for BullMQ queue)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-another-random-string-32-chars

# Telegram (server-level fallback, users can override via UI)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Telegram Bot (per-user, users register via web UI)
TELEGRAM_BOT_TOKEN=

# Telegram Storage Channel
TDRIVE_STORAGE_CHANNEL=TeleDrive Storage

# App URL (for bot dashboard links)
APP_URL=http://localhost:3000

# Upload Limits (bytes). Set to a large value or leave blank for unlimited.
TDRIVE_MAX_UPLOAD_BYTES=
TDRIVE_MAX_ARCHIVE_BYTES=
TDRIVE_MAX_EDITOR_BYTES=5242880

# Server Files (optional, operator can configure via UI)
SERVER_FILES_MODE=local
SERVER_FILES_ROOT=./server-files

# SFTP (if SERVER_FILES_MODE=sftp)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_KEY_PATH=
SFTP_ROOT=/

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
